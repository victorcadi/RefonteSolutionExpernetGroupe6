{% extends 'base.html.twig' %}

{% block title %}{{ error ? 'Erreur – ' : '' }}Connexion à l’espace formation{% endblock %}
{% block robots %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    {% embed 'security/_carte_connexion.html.twig' with {
        titre: 'Connexion',
        intro: 'Accédez à votre planning, à vos émargements et à vos résultats.',
    } %}
        {% block contenu %}
            {% if error %}
                <div class="alert alert-danger" role="alert" id="erreur-connexion">
                    {{ icone('x-circle-fill') }}
                    <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" novalidate>
                <div class="mb-3">
                    <label class="form-label" for="identifiant">Adresse e-mail</label>
                    <input type="email" class="form-control{{ error ? ' is-invalid' : '' }}" id="identifiant" name="_username"
                           value="{{ last_username }}" autocomplete="username" required maxlength="180"
                           {% if error %}aria-invalid="true" aria-describedby="erreur-connexion"{% endif %}>
                </div>
                <div class="mb-4">
                    <label class="form-label" for="mot-de-passe">Mot de passe</label>
                    <input type="password" class="form-control{{ error ? ' is-invalid' : '' }}" id="mot-de-passe" name="_password"
                           autocomplete="current-password" required
                           {% if error %}aria-invalid="true" aria-describedby="erreur-connexion"{% endif %}>
                </div>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-expernet-primary w-100" type="submit">{{ icone('box-arrow-right') }} Se connecter</button>
            </form>

            <p class="small mt-4 mb-0">
                Mot de passe oublié ou compte bloqué ? Contactez l’équipe pédagogique à
                <a href="mailto:{{ expernet.email }}">{{ expernet.email }}</a> ou au
                <a href="tel:{{ expernet.telephone_international }}">{{ expernet.telephone }}</a>.
            </p>
        {% endblock %}
    {% endembed %}
{% endblock %}
