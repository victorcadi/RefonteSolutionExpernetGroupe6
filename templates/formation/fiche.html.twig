{% extends 'base.html.twig' %}

{% set alternance = formation.alternance %}
{% set univers = formation.type.value %}
{% set sessions = formation.sessionsAVenir %}
{% set prochaine = sessions|first ?: null %}
{% set url_catalogue = path('app_catalogue', {univers: univers}) %}

{% block title %}{{ formation.intitule }} – {{ alternance ? 'formation en alternance' : 'formation continue' }}{% endblock %}
{% block meta_description %}{{ formation.resume }}{% endblock %}
{% block canonical %}{{ url('app_formation_fiche', {univers: univers, slug: formation.slug}) }}{% endblock %}

{% block donnees_structurees %}
    {{ parent() }}
    {# Les données de démonstration ne sont pas publiées en données structurées. #}
    {% if not expernet_demo %}
        {{ include('formation/_jsonld_course.html.twig') }}
    {% endif %}
{% endblock %}

{% block body %}
    {# En-tête de fiche (maquette : titre, public, prochaine session, objectifs, actions) #}
    <header class="entete-page">
        <div class="forme-deco forme-deco--bas-droite" aria-hidden="true"></div>
        <div class="container-xl position-relative">
            {{ include('partials/_fil_ariane.html.twig', {elements: [
                {libelle: 'Accueil', url: path('app_accueil')},
                {libelle: alternance ? 'Formations en alternance' : 'Formations continues', url: url_catalogue},
                {libelle: formation.intitule},
            ]}) }}

            <div class="row g-4 align-items-start">
                <div class="col-lg-8">
                    <p class="d-flex flex-wrap gap-2 mb-0 mt-2">
                        <span class="badge-expernet {{ alternance ? 'badge-expernet--alternance' : 'badge-expernet--univers' }}">{{ formation.type.libelle }}</span>
                        <span class="badge-expernet">{{ formation.thematique.nom }}</span>
                        {% if formation.niveauRncp %}<span class="badge-expernet badge-expernet--niveau">Niveau {{ formation.niveauRncp }} – {{ formation.niveauLibelle }}</span>{% endif %}
                        {% if formation.eligibleCpf %}<span class="badge-expernet badge-expernet--cpf">Éligible au CPF</span>{% endif %}
                    </p>

                    <h1>{{ formation.intitule }}</h1>
                    <p class="texte-intro"><strong>Public :</strong> {{ formation.public }}</p>
                    <p class="texte-lecture">{{ formation.resume }}</p>

                    {% set objectifs = formation.elementsParType(enum('App\\Enum\\TypeElementFiche').Objectif) %}
                    {% if objectifs is not empty %}
                        <h2 class="h5 fw-bold mt-4">Objectifs de la formation</h2>
                        <ul class="liste-puces">
                            {% for objectif in objectifs %}<li>{{ objectif.libelle }}</li>{% endfor %}
                        </ul>
                    {% endif %}

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a class="btn btn-expernet-primary" href="#demande">
                            {{ alternance ? 'Candidater' : 'Demander un devis' }} {{ icone('arrow-right') }}
                        </a>
                        <a class="btn btn-expernet-secondary" href="{{ path('app_formation_programme', {univers: univers, slug: formation.slug}) }}">
                            {{ icone('download') }} Télécharger le programme <span class="visually-hidden">(PDF)</span>
                        </a>
                    </div>
                </div>

                {# Informations clés (maquette : prix, durée, prochaine session) #}
                <aside class="col-lg-4" aria-labelledby="titre-infos-cles">
                    <div class="encart">
                        <h2 id="titre-infos-cles" class="h5 fw-bold">En bref</h2>
                        <dl class="mb-0">
                            <dt>{{ icone('clock', 'me-1 text-primary') }} Durée</dt>
                            <dd>{{ formation.duree }}</dd>
                            {% if alternance and formation.rythme %}
                                <dt>{{ icone('briefcase-fill', 'me-1 text-primary') }} Rythme</dt>
                                <dd>{{ formation.rythme }}</dd>
                            {% endif %}
                            <dt>{{ icone('geo-alt', 'me-1 text-primary') }} Modalité</dt>
                            <dd>{{ formation.modalite.libelle }}</dd>
                            <dt>{{ icone('calculator', 'me-1 text-primary') }} Tarif</dt>
                            <dd>
                                {% if alternance %}
                                    Formation financée, gratuite et rémunérée pour l’alternant
                                {% elseif formation.prix %}
                                    {{ formation.prix|format_currency('EUR', {fraction_digit: 0}, locale: 'fr') }} HT par participant
                                {% else %}
                                    Sur devis
                                {% endif %}
                            </dd>
                            <dt>{{ icone('calendar-event', 'me-1 text-primary') }} {{ alternance ? 'Prochaine rentrée' : 'Prochaine session' }}</dt>
                            <dd class="mb-0">
                                {% if prochaine %}
                                    <time datetime="{{ prochaine.dateDebut|date('Y-m-d') }}">{{ prochaine.dateDebut|format_date('long', locale: 'fr') }}</time>, {{ prochaine.lieu }}
                                {% else %}
                                    Sur demande
                                {% endif %}
                            </dd>
                        </dl>
                    </div>
                </aside>
            </div>
        </div>
    </header>

    {# Alternance : validation, sélection, rythme (maquette fiche alternance) #}
    {% if alternance %}
        <section class="section section-primaire theme-sombre" aria-labelledby="titre-admission">
            <div class="container-xl">
                <h2 id="titre-admission" class="section-titre">Certification et <span class="mot-cle">admission</span></h2>
                <ul class="row g-4 liste-sans-puce mb-0">
                    <li class="col-md-4">
                        <div class="encart h-100 text-body">
                            <h3 class="h4">{{ icone('award-fill', 'text-primary me-1') }} Validation</h3>
                            <p class="mb-0">
                                {{ formation.certification ?? 'Certification professionnelle' }}{% if formation.niveauRncp %}, de niveau {{ formation.niveauRncp }} ({{ formation.niveauLibelle }}){% endif %}.
                                {% if formation.codeRncp %}Inscrite au Répertoire national des certifications professionnelles sous le numéro {{ formation.codeRncp|replace({'RNCP': 'RNCP '}) }}.{% endif %}
                            </p>
                        </div>
                    </li>
                    <li class="col-md-4">
                        <div class="encart h-100 text-body">
                            <h3 class="h4">{{ icone('clipboard-check', 'text-primary me-1') }} Sélection</h3>
                            <p class="mb-0">{{ formation.selection ?? 'Dossier de candidature et entretien de motivation.' }}</p>
                        </div>
                    </li>
                    <li class="col-md-4">
                        <div class="encart h-100 text-body">
                            <h3 class="h4">{{ icone('briefcase-fill', 'text-primary me-1') }} En alternance</h3>
                            <p class="mb-0">{{ formation.rythme ?? formation.duree }}</p>
                        </div>
                    </li>
                </ul>
            </div>
        </section>
    {% endif %}

    {# Contenu pédagogique (maquette : colonne de rubriques + programme) #}
    <section class="section" aria-labelledby="titre-contenu">
        <div class="container-xl">
            <h2 id="titre-contenu" class="visually-hidden">Contenu de la formation</h2>
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="encart section-claire">
                        {% for type in enum_cases('App\\Enum\\TypeElementFiche') %}
                            {% set elements = formation.elementsParType(type) %}
                            {% if type.value != 'objectif' and elements is not empty %}
                                <h3 class="h5 fw-bold bg-white rounded px-3 py-2{{ not loop.first ? ' mt-4' : '' }}">{{ type.libelle }}</h3>
                                <ul class="liste-puces mb-0">
                                    {% for element in elements %}<li>{{ element.libelle }}</li>{% endfor %}
                                </ul>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="encart section-claire h-100">
                        <h3 class="h5 fw-bold bg-white rounded px-3 py-2">Programme</h3>
                        {% if formation.chapitres is empty %}
                            <p class="mb-0">Le programme détaillé est disponible sur demande.</p>
                        {% else %}
                            <ol class="liste-puces mb-0">
                                {% for chapitre in formation.chapitres %}
                                    <li class="mt-3">
                                        <strong>{{ chapitre.titre }}</strong>
                                        <ul class="mt-1">
                                            {% for module in chapitre.modules %}<li>{{ module.libelle }}</li>{% endfor %}
                                        </ul>
                                    </li>
                                {% endfor %}
                            </ol>
                        {% endif %}
                        {% if formation.description %}
                            <div class="mt-4">{{ formation.description|nl2br }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# Sessions (maquette : « Planifiez votre session – Autres sessions ») #}
    <section class="section section-claire" aria-labelledby="titre-sessions">
        <div class="container-xl">
            <span class="surtitre">Planifiez votre {{ alternance ? 'rentrée' : 'session' }}</span>
            <h2 id="titre-sessions" class="section-titre">{{ alternance ? 'Prochaines rentrées' : 'Prochaines sessions' }}</h2>
            {% if sessions is empty %}
                <p class="mb-0">Aucune date n’est programmée pour le moment. Faites une demande : nous organisons des sessions selon les besoins des entreprises.</p>
            {% else %}
                <div class="table-responsive" tabindex="0" role="region" aria-labelledby="titre-sessions">
                    <table class="table table-striped table-expernet align-middle">
                        <caption class="visually-hidden">{{ alternance ? 'Dates de rentrée' : 'Dates des sessions' }} de la formation {{ formation.intitule }}</caption>
                        <thead>
                            <tr>
                                <th scope="col">Date de début</th>
                                <th scope="col">Date de fin</th>
                                <th scope="col">Lieu</th>
                                <th scope="col">Disponibilité</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for session in sessions %}
                                <tr>
                                    <td><time datetime="{{ session.dateDebut|date('Y-m-d') }}">{{ session.dateDebut|date('d/m/Y') }}</time></td>
                                    <td><time datetime="{{ session.dateFin|date('Y-m-d') }}">{{ session.dateFin|date('d/m/Y') }}</time></td>
                                    <td>{{ session.lieu }}</td>
                                    <td>{{ session.statut.libelle }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </section>

    {# Demande (devis ou candidature) — formulaire ajouté avec le module de demandes #}
    <section id="demande" class="section" aria-labelledby="titre-demande" tabindex="-1">
        <div class="container-xl">
            <h2 id="titre-demande" class="section-titre text-center">{{ alternance ? 'Candidater' : 'Demander un devis' }}</h2>
            {% block demande %}
                <p class="text-center mb-0">
                    Appelez-nous au <a href="tel:{{ expernet.telephone_international }}">{{ expernet.telephone }}</a>
                    ou écrivez-nous à <a href="mailto:{{ expernet.email }}">{{ expernet.email }}</a>.
                </p>
            {% endblock %}
        </div>
    </section>

    {% if similaires is not empty %}
        <section class="section section-bleue" aria-labelledby="titre-similaires">
            <div class="container-xl">
                <h2 id="titre-similaires" class="section-titre">Ces formations peuvent aussi vous <span class="mot-cle">intéresser</span></h2>
                <ul class="row g-4 liste-sans-puce mb-0">
                    {% for autre in similaires %}
                        <li class="col-md-6 col-lg-4">{{ include('components/_carte_formation.html.twig', {formation: autre}) }}</li>
                    {% endfor %}
                </ul>
            </div>
        </section>
    {% endif %}
{% endblock %}
