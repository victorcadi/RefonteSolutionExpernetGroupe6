{% extends 'ent/_base.html.twig' %}

{% block title %}Mes examens{% endblock %}

{% block contenu %}
    <h1>Mes examens</h1>
    <p class="texte-intro texte-lecture">
        Vos convocations et, une fois l’examen clôturé par le jury, le niveau atteint pour chaque compétence évaluée.
    </p>

    <div class="row g-4 mb-4">
        <section class="col-lg-6" aria-labelledby="titre-a-venir">
            <div class="encart">
                <h2 id="titre-a-venir" class="h4">À venir</h2>
                {% if a_venir is empty %}
                    <p class="mb-0">Aucun examen programmé.</p>
                {% else %}
                    <ul class="liste-sans-puce liste-creneaux mb-0">
                        {% for examen in a_venir %}
                            <li>
                                <p class="mb-1 fw-bold">{{ examen.intitule }}</p>
                                {{ include('ent/examen/_recap.html.twig') }}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </section>

        <section class="col-lg-6" aria-labelledby="titre-correction">
            <div class="encart section-claire">
                <h2 id="titre-correction" class="h4">En attente de résultats</h2>
                {% if en_correction is empty %}
                    <p class="mb-0">Aucun examen en cours d’évaluation.</p>
                {% else %}
                    <ul class="liste-sans-puce liste-creneaux mb-0">
                        {% for examen in en_correction %}
                            <li>
                                <p class="mb-0 fw-bold">{{ examen.intitule }}</p>
                                <p class="mb-0 small">
                                    Passé le <time datetime="{{ examen.dateExamen|date('c') }}">{{ examen.dateExamen|format_date('long', locale: 'fr') }}</time>.
                                    Les résultats seront visibles ici après la clôture par le jury.
                                </p>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </section>
    </div>

    <h2>Résultats</h2>
    {% if resultats is empty %}
        <p>Aucun résultat publié pour le moment.</p>
    {% endif %}
    {% for grille in resultats %}
        {% set examen = grille.examen %}
        {% set numero = loop.index %}
        <section class="encart h-auto mb-4" aria-labelledby="resultat-{{ numero }}">
            <h3 id="resultat-{{ numero }}" class="h4">{{ examen.intitule }}</h3>
            <p class="small">
                {{ examen.type.libelle }} du <time datetime="{{ examen.dateExamen|date('Y-m-d') }}">{{ examen.dateExamen|format_date('long', locale: 'fr') }}</time>,
                résultats publiés le <time datetime="{{ examen.clotureLe|date('Y-m-d') }}">{{ examen.clotureLe|format_date('long', locale: 'fr') }}</time>.
            </p>

            <dl class="grille-indicateurs mb-4">
                {% for bloc, synthese in grille.syntheseParBloc(app.user) %}
                    <div class="chiffre-cle encart">
                        <dt>{{ bloc }}</dt>
                        <dd>{{ synthese.acquises }} / {{ synthese.total }} <span class="small fw-normal">compétence{{ synthese.total > 1 ? 's' : '' }} acquise{{ synthese.acquises > 1 ? 's' : '' }}</span></dd>
                    </div>
                {% endfor %}
            </dl>

            {% for bloc, competences in examen.competencesParBloc %}
                <div class="table-responsive" tabindex="0" role="region" aria-labelledby="legende-{{ numero }}-{{ loop.index }}">
                    <table class="table table-striped table-expernet align-top">
                        <caption id="legende-{{ numero }}-{{ loop.index }}">{{ bloc }}</caption>
                        <thead>
                            <tr>
                                <th scope="col">Compétence</th>
                                <th scope="col">Niveau</th>
                                <th scope="col">Commentaire du jury</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for competence in competences %}
                                {% set evaluation = grille.evaluation(app.user, competence.id) %}
                                <tr>
                                    <th scope="row" class="fw-normal">{{ competence.libelle }}</th>
                                    <td>{{ evaluation ? evaluation.niveau.libelle : 'Non évaluée' }}</td>
                                    <td>{{ evaluation and evaluation.commentaire ? evaluation.commentaire : '–' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endfor %}
            <p class="small mb-0">
                Ces résultats portent sur les compétences évaluées lors de cette épreuve.
                La décision de certification appartient au jury de délivrance du titre.
            </p>
        </section>
    {% endfor %}
{% endblock %}
