{% extends 'ent/_base.html.twig' %}

{% block title %}Examens{% endblock %}

{% block contenu %}
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <h1 class="mb-0">Examens</h1>
        <a class="btn btn-expernet-primary" href="{{ path('app_ent_admin_examen_nouveau') }}">{{ icone('calendar-event') }} Planifier un examen</a>
    </div>
    <p class="texte-intro texte-lecture">
        Planifiez les épreuves, composez les jurys et choisissez les compétences évaluées.
        Le jury remplit ensuite les grilles et clôture l’examen pour publier les résultats.
    </p>

    {% if examens is empty %}
        <div class="alert alert-info" role="status">
            {{ icone('info-circle-fill') }}
            <div>Aucun examen n’est planifié.</div>
        </div>
    {% else %}
        <div class="table-responsive" tabindex="0" role="region" aria-labelledby="legende-examens">
            <table class="table table-striped table-expernet align-middle">
                <caption id="legende-examens">Examens planifiés, du plus récent au plus ancien</caption>
                <thead>
                    <tr>
                        <th scope="col">Épreuve</th>
                        <th scope="col">Date</th>
                        <th scope="col">Promotion</th>
                        <th scope="col">Jury</th>
                        <th scope="col">État</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for examen in examens %}
                        <tr>
                            <th scope="row" class="fw-normal">
                                <span class="fw-bold">{{ examen.intitule }}</span><br>
                                <span class="small">{{ examen.type.libelle }} · {{ examen.competences|length }} compétence{{ examen.competences|length > 1 ? 's' : '' }}</span>
                            </th>
                            <td><time datetime="{{ examen.dateExamen|date('c') }}">{{ examen.dateExamen|format_datetime('medium', 'short', locale: 'fr') }}</time></td>
                            <td>{{ examen.promotion.nom }}</td>
                            <td>{{ examen.jury|map(m => m.nomComplet)|join(', ') }}</td>
                            <td>{{ include('ent/examen/_statut.html.twig') }}</td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <a class="btn btn-expernet-secondary btn-sm" href="{{ path('app_ent_jury_examen', {id: examen.id}) }}">
                                        {{ icone('clipboard-check') }} Suivi<span class="visually-hidden"> de l’examen {{ examen.intitule }}</span>
                                    </a>
                                    {% if is_granted('EXAMEN_MODIFIER', examen) %}
                                        <a class="btn btn-expernet-secondary btn-sm" href="{{ path('app_ent_admin_examen_modifier', {id: examen.id}) }}">
                                            {{ icone('pencil-square') }} Modifier<span class="visually-hidden"> l’examen {{ examen.intitule }}</span>
                                        </a>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
