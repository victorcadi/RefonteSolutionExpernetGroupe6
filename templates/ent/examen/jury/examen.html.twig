{% extends 'ent/_base.html.twig' %}

{% set examen = grille.examen %}
{% set statut = examen.statut(maintenant) %}
{% block title %}Examen – {{ examen.intitule }}{% endblock %}

{% block contenu %}
    <p class="small mb-2">
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_ent_admin_examens') }}">{{ icone('arrow-left') }} Retour aux examens</a>
        {% else %}
            <a href="{{ path('app_ent_jury_examens') }}">{{ icone('arrow-left') }} Retour à mes jurys</a>
        {% endif %}
    </p>
    <h1>{{ examen.intitule }}</h1>

    <div class="row g-4 mb-4">
        <section class="col-lg-7" aria-labelledby="titre-epreuve">
            <div class="encart">
                <h2 id="titre-epreuve" class="h5">Épreuve</h2>
                {{ include('ent/examen/_recap.html.twig', {avec_jury: true}) }}
            </div>
        </section>
        <section class="col-lg-5" aria-labelledby="titre-avancement">
            <div class="encart section-claire">
                <h2 id="titre-avancement" class="h5">Avancement {{ include('ent/examen/_statut.html.twig') }}</h2>
                {% set candidats = grille.candidats %}
                {% set completes = candidats|length - grille.candidatsIncomplets|length %}
                <p class="chiffre-assiduite mb-1">{{ completes }} / {{ candidats|length }}</p>
                <p>grille{{ candidats|length > 1 ? 's' : '' }} complète{{ completes > 1 ? 's' : '' }} ({{ grille.nombreCompetences }} compétence{{ grille.nombreCompetences > 1 ? 's' : '' }} par candidat).</p>

                {% if statut.value == 'a_venir' %}
                    <p class="mb-0">La saisie s’ouvrira au début de l’épreuve.</p>
                {% elseif statut.value == 'cloture' %}
                    <p class="mb-0">
                        Clôturé le <time datetime="{{ examen.clotureLe|date('c') }}">{{ examen.clotureLe|format_datetime('long', 'short', locale: 'fr') }}</time>
                        {{ examen.cloturePar ? 'par ' ~ examen.cloturePar.nomComplet : '' }}.
                        Les candidats peuvent consulter leurs résultats.
                    </p>
                {% elseif is_granted('EXAMEN_CLOTURER', examen) %}
                    {% if grille.estComplete() %}
                        <p>Toutes les grilles sont remplies. Après la clôture, elles ne seront plus modifiables et les résultats seront visibles des candidats.</p>
                        {{ form_start(cloture) }}
                            <button type="submit" class="btn btn-expernet-primary btn-sm">{{ icone('award-fill') }} Clôturer l’examen</button>
                        {{ form_end(cloture) }}
                    {% else %}
                        <p class="mb-0">La clôture sera possible quand toutes les grilles seront complètes.</p>
                    {% endif %}
                {% else %}
                    <p class="mb-0">La saisie et la clôture sont réservées aux membres du jury.</p>
                {% endif %}
            </div>
        </section>
    </div>

    <div class="table-responsive" tabindex="0" role="region" aria-labelledby="legende-candidats">
        <table class="table table-striped table-expernet align-middle">
            <caption id="legende-candidats">Grilles des candidats de la promotion {{ examen.promotion.nom }}</caption>
            <thead>
                <tr>
                    <th scope="col">Candidat</th>
                    <th scope="col">Compétences évaluées</th>
                    {% for bloc in examen.competencesParBloc|keys %}
                        <th scope="col">Acquises – {{ bloc }}</th>
                    {% endfor %}
                    <th scope="col">Grille</th>
                </tr>
            </thead>
            <tbody>
                {% for candidat in grille.candidats %}
                    <tr>
                        <th scope="row" class="fw-normal">{{ candidat.nom|upper }} {{ candidat.prenom }}</th>
                        <td>
                            {% if grille.estCompletePour(candidat) %}
                                <span class="badge-expernet badge-expernet--succes">{{ icone('check-circle-fill') }} Complète</span>
                            {% else %}
                                {{ grille.nombreEvaluees(candidat) }} / {{ grille.nombreCompetences }}
                            {% endif %}
                        </td>
                        {% for synthese in grille.syntheseParBloc(candidat) %}
                            <td>{{ synthese.acquises }} / {{ synthese.total }}</td>
                        {% endfor %}
                        <td>
                            {% if statut.value != 'a_venir' %}
                                <a href="{{ path('app_ent_jury_grille', {id: examen.id, etudiant: candidat.id}) }}">
                                    {{ is_granted('EXAMEN_EVALUER', examen) ? 'Remplir' : 'Consulter' }}<span class="visually-hidden"> la grille de {{ candidat.nomComplet }}</span>
                                </a>
                            {% else %}
                                –
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
