{% extends 'ent/_base.html.twig' %}

{% block title %}Feuille d’émargement – {{ creneau.intitule }}{% endblock %}

{% block contenu %}
    <h1>Feuille d’émargement</h1>

    <div class="row g-4 mb-4">
        <section class="col-lg-7" aria-labelledby="titre-cours">
            <div class="encart">
                <h2 id="titre-cours" class="h5">Cours</h2>
                {{ include('ent/emargement/_creneau.html.twig') }}
            </div>
        </section>
        <section class="col-lg-5" aria-labelledby="titre-bilan">
            <div class="encart section-claire">
                <h2 id="titre-bilan" class="h5">Bilan</h2>
                <p class="chiffre-assiduite mb-1">{{ presents }} / {{ lignes|length }}</p>
                <p class="mb-3">
                    étudiant{{ lignes|length > 1 ? 's' : '' }} ont signé
                    {%- if en_cours %} (cours en cours, signature possible jusqu’à {{ creneau.fin|date('H:i') }}){% elseif not termine %} (cours à venir){% endif %}.
                </p>
                <a class="btn btn-expernet-secondary btn-sm" href="{{ path('app_ent_feuille_emargement_pdf', {id: creneau.id}) }}">
                    {{ icone('file-earmark-pdf-fill') }} Télécharger la feuille (PDF)
                </a>
            </div>
        </section>
    </div>

    {% if sceaux_alteres > 0 %}
        <div class="alert alert-danger" role="alert">
            {{ icone('shield-exclamation') }}
            <div>
                {{ sceaux_alteres }} émargement{{ sceaux_alteres > 1 ? 's ont' : ' a' }} été modifié{{ sceaux_alteres > 1 ? 's' : '' }} après la signature :
                le sceau ne correspond plus. Signalez-le à l’administration.
            </div>
        </div>
    {% endif %}

    <div class="table-responsive" tabindex="0" role="region" aria-labelledby="legende-feuille">
        <table class="table table-striped table-expernet align-middle">
            <caption id="legende-feuille">Signatures des étudiants de la promotion {{ creneau.promotion.nom }}</caption>
            <thead>
                <tr>
                    <th scope="col">Étudiant</th>
                    <th scope="col">Présence</th>
                    <th scope="col">Signé à</th>
                    <th scope="col">Signature</th>
                    <th scope="col">Sceau</th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in lignes %}
                    {% set emargement = ligne.emargement %}
                    <tr>
                        <th scope="row" class="fw-normal">{{ ligne.etudiant.nom|upper }} {{ ligne.etudiant.prenom }}</th>
                        <td>
                            {% if emargement %}
                                <span class="badge-expernet badge-expernet--succes">{{ icone('check-circle-fill') }} Présent(e)</span>
                            {% elseif termine %}
                                <span class="badge-expernet badge-expernet--alerte">{{ icone('x-circle-fill') }} Absent(e)</span>
                            {% else %}
                                <span class="badge-expernet">En attente</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if emargement %}<time datetime="{{ emargement.signeLe|date('c') }}">{{ emargement.signeLe|date('H:i') }}</time>{% else %}–{% endif %}
                        </td>
                        <td>
                            {% if emargement is null %}
                                –
                            {% elseif emargement.mode.value == 'manuscrite' %}
                                <img src="{{ emargement.signature }}" class="signature-miniature" width="150" height="50"
                                     alt="Signature tracée de {{ ligne.etudiant.nomComplet }}">
                            {% else %}
                                <span class="small">{{ emargement.mode.libelle }} : « {{ emargement.signature }} »</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if emargement is null %}
                                –
                            {% elseif ligne.integre %}
                                <span class="badge-expernet badge-expernet--succes">{{ icone('shield-check') }} Vérifié</span>
                            {% else %}
                                <span class="badge-expernet badge-expernet--alerte">{{ icone('shield-exclamation') }} Modifié</span>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Aucun étudiant dans cette promotion.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <p class="mt-4">
        <a class="btn btn-expernet-secondary" href="{{ path('app_ent_planning_formateur', {semaine: creneau.debut|date('o-\\WW')}) }}">
            {{ icone('arrow-left') }} Retour au planning de la semaine
        </a>
    </p>
{% endblock %}
