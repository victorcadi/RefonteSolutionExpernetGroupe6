{% extends 'ent/_base.html.twig' %}

{% block title %}Présences de {{ etudiant.nomComplet }}{% endblock %}

{% block contenu %}
    <p class="small mb-2"><a href="{{ path('app_ent_assiduite_promotion', {id: promotion.id}) }}">{{ icone('arrow-left') }} Assiduité de la promotion</a></p>
    <h1>Présences de {{ etudiant.nomComplet }}</h1>

    <div class="row g-4 mb-4">
        <section class="col-lg-5" aria-labelledby="titre-bilan">
            <div class="encart section-claire">
                <h2 id="titre-bilan" class="h5">Bilan</h2>
                <p class="chiffre-assiduite mb-1">{{ include('ent/assiduite/_taux.html.twig') }}</p>
                <p>de présence : {{ assiduite.presences }} cours émargé{{ assiduite.presences > 1 ? 's' : '' }} sur {{ assiduite.creneauxTermines }}.</p>
                <div class="d-flex flex-wrap gap-1">{{ include('ent/assiduite/_motifs.html.twig') }}</div>
            </div>
        </section>
        <section class="col-lg-7" aria-labelledby="titre-contact">
            <div class="encart">
                <h2 id="titre-contact" class="h5">Contact</h2>
                <dl class="recap-creneau mb-0">
                    <div>
                        <dt>Promotion</dt>
                        <dd>{{ promotion.nom }}</dd>
                    </div>
                    <div>
                        <dt>E-mail</dt>
                        <dd><a href="mailto:{{ etudiant.email }}">{{ etudiant.email }}</a></dd>
                    </div>
                    {% if promotion.formateurReferent %}
                        <div>
                            <dt>Formateur référent</dt>
                            <dd>{{ promotion.formateurReferent.nomComplet }}</dd>
                        </div>
                    {% endif %}
                </dl>
            </div>
        </section>
    </div>

    {% if creneaux is empty %}
        <p>Aucun cours terminé pour le moment.</p>
    {% else %}
        <div class="table-responsive" tabindex="0" role="region" aria-labelledby="legende-presences">
            <table class="table table-striped table-expernet align-middle">
                <caption id="legende-presences">Cours terminés, du plus récent au plus ancien</caption>
                <thead>
                    <tr>
                        <th scope="col">Cours</th>
                        <th scope="col">Date</th>
                        <th scope="col">Présence</th>
                        <th scope="col">Feuille</th>
                    </tr>
                </thead>
                <tbody>
                    {% for creneau in creneaux %}
                        {% set emargement = emargements[creneau.id] ?? null %}
                        <tr>
                            <th scope="row" class="fw-normal">{{ creneau.intitule }}</th>
                            <td>
                                <time datetime="{{ creneau.debut|date('c') }}">{{ creneau.debut|format_date('full', locale: 'fr')|capitalize }}</time>,
                                {{ creneau.debut|date('H:i') }} – {{ creneau.fin|date('H:i') }}
                            </td>
                            <td>
                                {% if emargement %}
                                    <span class="badge-expernet badge-expernet--succes">{{ icone('check-circle-fill') }} Présent(e)</span>
                                    <span class="small">signé à <time datetime="{{ emargement.signeLe|date('c') }}">{{ emargement.signeLe|date('H:i') }}</time></span>
                                {% else %}
                                    <span class="badge-expernet badge-expernet--alerte">{{ icone('x-circle-fill') }} Absent(e)</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if is_granted('FEUILLE_EMARGEMENT_CONSULTER', creneau) %}
                                    <a href="{{ path('app_ent_feuille_emargement', {id: creneau.id}) }}">
                                        Voir<span class="visually-hidden"> la feuille d’émargement du {{ creneau.debut|format_datetime('long', 'short', locale: 'fr') }}</span>
                                    </a>
                                {% else %}
                                    –
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
